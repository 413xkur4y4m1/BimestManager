# ============================================================
# BimestManager - Variables para despliegue en la NUBE (Coolify)
# ============================================================
# Copia estos valores en: Coolify > tu recurso > Environment Variables.
# NO subas un .env real al repo: Coolify inyecta estas variables al contenedor.
# ============================================================

# ============ Servidor ============
# Coolify/Traefik termina TLS (HTTPS publico con Let's Encrypt) y reenvia
# el trafico a este puerto HTTP interno. Por eso HTTPS_ENABLED=false.
PORT=4000
HTTPS_ENABLED=false
NODE_ENV=production
LOG_LEVEL=info

# ============ Base de datos (MySQL gestionado por Coolify) ============
# Crea en Coolify un recurso "Database > MySQL" (o MariaDB) en el MISMO
# proyecto/servidor. Coolify te da un hostname INTERNO de Docker: usalo aqui.
# Ese hostname es el nombre del servicio/recurso de la base (ej: "mysql-xxxxxx").
# Como el trafico viaja por la red interna de Docker, no hace falta TLS.
DB_HOST=REEMPLAZA_CON_HOSTNAME_INTERNO_DE_COOLIFY
DB_PORT=3306
DB_USER=bimest_app
DB_PASSWORD=REEMPLAZA_CON_PASSWORD_FUERTE
DB_NAME=labs

# TLS hacia la base: false porque la conexion es interna (red privada Docker).
# Si algun dia conectas a una DB externa publica, pon DB_SSL=true y monta el CA.
DB_SSL=false
DB_SSL_CA=./certs/mysql-ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# ============ JWT (genera valores largos y aleatorios) ============
# Sugerencia: openssl rand -hex 48
JWT_SECRET=REEMPLAZA_CON_SECRETO_LARGO_Y_ALEATORIO
JWT_REFRESH_SECRET=REEMPLAZA_CON_OTRO_SECRETO_LARGO_Y_ALEATORIO
AUTH_COOKIE_MAX_AGE_MS=7200000

# ============ Monitoreo remoto (Tailscale) ============
# En la nube normalmente NO aplica: dejar MONITOR_URL vacio lo desactiva.
# (El servidor sigue logueando a archivo dentro del contenedor.)
MONITOR_URL=
MONITOR_ORIGEN=bimest-cloud
MONITOR_INTERVAL_MS=5000
MONITOR_LEVEL=info
MONITOR_REDIRECT=false
MONITOR_DEBUG=false
