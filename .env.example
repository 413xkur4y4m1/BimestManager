# ============ Servidor ============
PORT=3307
HTTPS_PORT=4443
HTTPS_ENABLED=true
HTTPS_CN=localhost
NODE_ENV=development
LOG_LEVEL=info

# ============ Base de datos ============
# Usuario de aplicación con permisos mínimos (NO root). Ver sql/usuario_app.sql
DB_HOST=localhost
DB_USER=bimest_app
DB_PASSWORD=Bimest_App_2026!_cambia_esto
DB_NAME=labs

# Cifrado TLS para MySQL. Pon DB_SSL=true cuando el server DB tenga certs.
DB_SSL=false
DB_SSL_CA=./certs/mysql-ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# ============ JWT ============
JWT_SECRET=cambia_esto_por_uno_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_esto_tambien
AUTH_COOKIE_MAX_AGE_MS=7200000

# =====================================================
# Servidor REMOTO de monitoreo y logs (proy en Tailscale)
# Autenticación: por IP (ambas PCs están en el mismo tailnet).
# =====================================================
# IP Tailscale del servidor proy (la PC del amigo).
# Comentar (poner en blanco) si querés desactivar el envío remoto.
MONITOR_URL=http://100.115.7.108:3000

# Identificador con el que proy etiqueta los logs/métricas recibidos
MONITOR_ORIGEN=bimest

# Intervalo de envío de métricas (ms)
MONITOR_INTERVAL_MS=5000

# Nivel mínimo de logs a empujar al servidor remoto
MONITOR_LEVEL=info

# Si "true": GET /monitor redirige al dashboard de proy.
# Si "false": sigue mostrando el dashboard local (debug).
MONITOR_REDIRECT=true

# Loguear localmente los errores de envío a proy (para debug de conexión)
MONITOR_DEBUG=false
