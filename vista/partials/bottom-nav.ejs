<%
  // Items: array de { href, label, icon, key }
  // active: la key activa
  // El item con center:true (logo flotante) se omite de la barra: la marca
  // vive ahora en .bottom-nav__brand (sidebar de escritorio) y en el header.
  const items = (typeof navItems !== 'undefined' ? navItems : []).filter((it) => it.center !== true);
  const activa = typeof active !== 'undefined' ? active : '';
%>
<nav class="bottom-nav" aria-label="Navegacion principal">
  <a href="#home" class="bottom-nav__brand" aria-label="Bimest Manager">
    <img src="/img/bimest-logo.png" alt="Bimest Manager">
    <span>Bimest</span>
  </a>
  <% items.forEach(function(it, i) {
       const isActive = it.key === activa;
  %>
    <a href="<%= it.href %>" class="bottom-nav__item <%= isActive ? 'is-active' : '' %>">
      <span class="bottom-nav__icon">
        <%- it.icon %>
      </span>
      <span><%= it.label %></span>
    </a>
  <% }) %>
</nav>
